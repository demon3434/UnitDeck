# ==========================================
# UnitDeck Git Attributes & Line Endings
# ==========================================

# Set default behavior to automatically normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare text files to always use LF (Linux/Docker standard)
*.py text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.conf text eol=lf
*.service text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf
Dockerfile text eol=lf

# Force bash shell scripts to always checkout as LF (prevents \r errors in Linux/Docker)
*.sh text eol=lf

# Binary files - Git will not attempt to normalize line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.tar binary
*.gz binary
*.zip binary

